# LLM provider for all LLM calls: gemini | openai. Empty = gemini. A restart applies a change. Only the selected provider needs a key.
LLM_PROVIDER=
# Google Gemini API (create the key at https://aistudio.google.com/apikey). Empty = no LLM; TRIAGE_LLM_SCOPE must stay off.
GEMINI_API_KEY=###
# Writer model (S4) and fallback. Model ID from https://ai.google.dev/gemini-api/docs/models (newest Flash, checked 2026-11-02)
GEMINI_MODEL=gemini-3.8-flash
# Classifier model (one call per mail). Empty = gemini-3.5-flash-lite
GEMINI_MODEL_CLASSIFIER=gemini-3.5-flash-lite
# Timeout of one LLM call in milliseconds
GEMINI_TIMEOUT_MS=30000
# LLM calls per minute (free tier: classifier RPM 15 x 0.8)
GEMINI_RPM=12
# OpenAI API: project key of an OpenAI project only for this app, with a monthly budget. Empty = no OpenAI.
OPENAI_API_KEY=
# Writer model (S4). Empty = the code default
OPENAI_MODEL=
# Classifier model (one call per mail)
OPENAI_MODEL_CLASSIFIER=gpt-6-luna
# Timeout of one LLM call in milliseconds
OPENAI_TIMEOUT_MS=30000
# LLM calls per minute
OPENAI_RPM=60
# Reasoning effort: lowest setting (ADR 0012)
OPENAI_REASONING_EFFORT=none
# LLM call attempts per mailbox per America/Los_Angeles day (ADR 0012)
LLM_DAILY_CAP=300
# off = no triage worker. synthetic = only synthetic mail (@ea-seed.test Message-IDs), in every mailbox.
# all = real mail of the TEST_MAILBOX_ADDRESS mailbox goes to the LLM provider (LLM_PROVIDER). Free tier: only the temporary pilot mailbox (ADR 0013). Any other person's mail: Cloud Billing first (ADR 0007/0012/0013). synthetic is not a security boundary.
TRIAGE_LLM_SCOPE=off

# off = the committer changes nothing in any mailbox (summaries are still saved). synthetic = mailbox changes only for synthetic mail
# (@ea-seed.test Message-IDs), in every mailbox. all = also real mail, only of the TEST_MAILBOX_ADDRESS mailbox. synthetic is not a security boundary.
ACTIONS_SCOPE=off

# off = no send goes out (approvals still work; approved sends wait). self = sends go only to the addresses in SEND_TEST_ADDRESSES.
# all = sends go to real delegates, only for the TEST_MAILBOX_ADDRESS mailbox.
SEND_SCOPE=off
# Your own addresses for test sends (comma-separated), needed with SEND_SCOPE=self. Never another person's address.
SEND_TEST_ADDRESSES=

# Telegram bot token from @BotFather. Dev bot on the Mac, pilot bot on the VPS: never the same token
# (one update consumer per token, ADR 0005). Empty = Telegram off. Secret: never print or log it.
TELEGRAM_BOT_TOKEN=
# Dev only: a local fake Bot API (tools/fake-telegram). Use http://127.0.0.1:<port> (the fake binds only 127.0.0.1); the config also accepts localhost and [::1]; no path, no trailing "/". Empty = the real Telegram.
TELEGRAM_API_ROOT=

# Dev Compose db: superuser and role passwords (the db init script reads them on an empty volume)
POSTGRES_PASSWORD=change-me-postgres
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

# The passwords in the URLs must match MIGRATOR_PASSWORD and APP_PASSWORD above
# Server connects as the DB role `app` (dev Compose db listens on host port 5433)
DATABASE_URL=postgres://app:change-me-app@127.0.0.1:5433/email_assistant?sslmode=disable
# dbmate runs the migrations as the DB role `migrator`
MIGRATOR_DATABASE_URL=postgres://migrator:change-me-migrator@127.0.0.1:5433/email_assistant?sslmode=disable
PORT=8080
LOG_LEVEL=info

# 32 random bytes, base64: openssl rand -base64 32. Store a copy in a password manager: key loss = all mailboxes connect again.
CREDENTIALS_KEY=###
CREDENTIALS_KEY_VERSION=1

# Local GreenMail test server (bun run dev:up)
TEST_IMAP_HOST=127.0.0.1
TEST_IMAP_PORT=3143
TEST_IMAPS_PORT=3993
TEST_SMTP_PORT=3025

# Dead-man's-switch ping URL (empty = heartbeat off)
HEARTBEAT_URL=

# Address of the test mailbox (mailbox:seed refuses all others)
TEST_MAILBOX_ADDRESS=
