# The classifier's LLM provider (gemini | openai), also used by every role without LLM_<ROLE>_PROVIDER. Empty = openai. A restart applies a change.
LLM_PROVIDER=
# Google Gemini API (create the key at https://aistudio.google.com/apikey). Empty = no LLM; TRIAGE_LLM_SCOPE must stay off.
GEMINI_API_KEY=###
# Classifier model (one call per mail). Empty = gemini-3.5-flash-lite
GEMINI_MODEL_CLASSIFIER=gemini-3.5-flash-lite
# Timeout of one LLM call in milliseconds
GEMINI_TIMEOUT_MS=30000
# LLM calls per minute (free tier: classifier RPM 15 x 0.8)
GEMINI_RPM=12
# OpenAI API: project key of an OpenAI project only for this app, with a monthly budget. Empty = no OpenAI.
OPENAI_API_KEY=
# Classifier model (one call per mail)
OPENAI_MODEL_CLASSIFIER=gpt-6-luna
# Timeout of one LLM call in milliseconds
OPENAI_TIMEOUT_MS=30000
# LLM calls per minute
OPENAI_RPM=60
# Reasoning effort: lowest setting (ADR 0012)
OPENAI_REASONING_EFFORT=none
# LLM roles other than the classifier (judge, drafter, extractor, escalation). Each key is optional; empty = the
# classifier's value when the role uses the classifier's provider, else the role provider's own keys.
# LLM_<ROLE>_PROVIDER needs that provider's API key; LLM_<ROLE>_MODEL needs LLM_<ROLE>_PROVIDER. LLM_<ROLE>_REASONING only for openai.
# LLM_<ROLE>_RPM empty = no own limit.
LLM_JUDGE_PROVIDER=
LLM_JUDGE_MODEL=
LLM_JUDGE_TIMEOUT_MS=
LLM_JUDGE_RPM=
LLM_JUDGE_REASONING=
LLM_DRAFTER_PROVIDER=
LLM_DRAFTER_MODEL=
LLM_DRAFTER_TIMEOUT_MS=
LLM_DRAFTER_RPM=
LLM_DRAFTER_REASONING=
LLM_EXTRACTOR_PROVIDER=
LLM_EXTRACTOR_MODEL=
LLM_EXTRACTOR_TIMEOUT_MS=
LLM_EXTRACTOR_RPM=
LLM_EXTRACTOR_REASONING=
LLM_ESCALATION_PROVIDER=
LLM_ESCALATION_MODEL=
LLM_ESCALATION_TIMEOUT_MS=
LLM_ESCALATION_RPM=
LLM_ESCALATION_REASONING=
# LLM call attempts per mailbox per America/Los_Angeles day (ADR 0012)
LLM_DAILY_CAP=300
# off = no triage worker. synthetic = only synthetic mail (@ea-seed.test Message-IDs or a sender in TEST_SENDER_ADDRESSES), in every mailbox.
# all = real mail of every active mailbox of an organization that is not suspended goes to the LLM provider (LLM_PROVIDER). Free tier: only the temporary pilot mailbox (ADR 0013). Any other person's mail: Cloud Billing first (ADR 0007/0012/0013). synthetic is not a security boundary.
TRIAGE_LLM_SCOPE=off

# off = the committer changes nothing in any mailbox (summaries are still saved). synthetic = mailbox changes only for synthetic mail
# (@ea-seed.test Message-IDs or a sender in TEST_SENDER_ADDRESSES), in every mailbox. all = real mail of every mailbox, by the mode and the switches of each mailbox. synthetic is not a security boundary.
ACTIONS_SCOPE=off

# off = no send goes out (approvals still work; approved sends wait). self = sends go only to the addresses in SEND_TEST_ADDRESSES.
# all = sends go to real recipients, always after an owner's tap.
SEND_SCOPE=off
# Your own addresses for test sends (comma-separated), needed with SEND_SCOPE=self. Never another person's address.
SEND_TEST_ADDRESSES=
# Test mail senders (comma list). Mail from these addresses counts as test mail: it is never a real label and only
# the `synthetic` scopes act on it. Example: the AgentMail inbox of evals/testmail/personas.json. Empty = none.
TEST_SENDER_ADDRESSES=
# Send limits per mailbox (PD-044): a send over a limit waits until the oldest send leaves the rolling window.
SEND_LIMIT_MAILBOX_HOUR=20
SEND_LIMIT_MAILBOX_DAY=100
# Sends from one mailbox to one address per rolling 24 h.
SEND_LIMIT_RECIPIENT_DAY=5

# Minutes between two mail syncs: 2 (default), 3 or 5. Use 3 when the mail host throttles logins.
MAIL_SYNC_EVERY_MIN=

# Telegram bot token from @BotFather. Dev bot on the Mac, pilot bot on the VPS: never the same token
# (one update consumer per token, ADR 0005). Empty = Telegram off. Secret: never print or log it.
TELEGRAM_BOT_TOKEN=
# Dev only: a local fake Bot API (tools/fake-telegram). Use http://127.0.0.1:<port> (the fake binds only 127.0.0.1); the config also accepts localhost and [::1]; no path, no trailing "/". Empty = the real Telegram.
TELEGRAM_API_ROOT=

# Web panel (S5). Empty = the web is off: no login, no pages, no /api. Dev: http://localhost:4321 (bun run web:dev proxies /api to 8080);
# the built shape (bun run web:build && bun run dev) is reached on http://127.0.0.1:8080 and needs that origin in WEB_TRUSTED_ORIGINS.
# Server (VPS behind Tailscale Serve, ADR 0017): https://<machine>.<tailnet>.ts.net (no path, no trailing slash).
WEB_BASE_URL=
# Public contact address shown in the paused banner and the paused Telegram answer; set it on the server, never in the repo
OPERATOR_CONTACT=
# optional: your own Telegram chat id for operator notices (ids only); needs TELEGRAM_BOT_TOKEN
OPERATOR_TELEGRAM_CHAT_ID=
# Kill switch: comma list of feature flag keys (packages/core/src/features.ts) that read off for every organization, without a DB write. An unknown key stops the start. Empty = none.
FEATURES_OFF=
# User ids (users.id, UUID, comma list) of the operator: only they reach /api/operator/*, every other user gets 404.
# A user id, not an e-mail address. Empty = no operator. Never log the ids.
OPERATOR_USER_IDS=
# Session cookie secret, 32 or more characters: openssl rand -base64 32. Required when WEB_BASE_URL is set. Secret: never print or log it.
WEB_AUTH_SECRET=
# Other browser origins that may call the API (comma list). Dev default below; VPS: empty.
# Server: delete this dev value (leave the key empty). The value below is for dev only (the built shape on 8080).
WEB_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Proxies that may set x-forwarded-for (IPs or CIDRs, comma list). Empty = none. VPS: the Compose bridge gateway (S5e).
# Server: the gateway IP of the Compose network (docker network inspect email-assistant_default), one IPv4, no CIDR. Read it again after "docker compose down". Empty = no proxy is trusted.
WEB_TRUSTED_PROXIES=
# The built web app folder. Empty = apps/web/dist (relative to the repo root); the image sets /app/apps/web/dist.
# Server: leave empty; Compose sets it.
WEB_DIST=
# true = mail hosts on localhost or a private network are allowed for the connect form, sync and send (dev with GreenMail, e2e). Server: leave empty.
MAIL_ALLOW_LOCAL_HOSTS=
# Old name of MAIL_ALLOW_LOCAL_HOSTS; still read when the new key is empty.
WEB_MAIL_ALLOW_LOCAL=
# Auth mail (S6b). Empty = off: the CLI prints invite and reset links. Server (home VPS): leave all empty.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_SECURITY=
AUTH_SMTP_USER=
# Secret: never print or log it.
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=
# on (default) = refuse passwords from the Have I Been Pwned list (sends 5 hex characters of the SHA-1, nothing else); off = tests only. Server: leave empty.
AUTH_PWNED_CHECK=
# Playwright (bun run test:e2e) uses its own database: bun run db:worktree e2e | grep -E '^(DATABASE_URL|MIGRATOR_DATABASE_URL)=' | sed 's/^/E2E_/' >> .env
E2E_DATABASE_URL=
E2E_MIGRATOR_DATABASE_URL=
# Local Playwright runs with the system Chromium (empty = Playwright's own browser, installed with bunx playwright install chromium).
CHROMIUM_PATH=

# Dev Compose db: superuser and role passwords (the db init script reads them on an empty volume)
POSTGRES_PASSWORD=change-me-postgres
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

# The passwords in the URLs must match MIGRATOR_PASSWORD and APP_PASSWORD above
# Server connects as the DB role `app` (dev Compose db listens on host port 5433)
DATABASE_URL=postgres://app:change-me-app@127.0.0.1:5433/email_assistant?sslmode=disable
# dbmate runs the migrations as the DB role `migrator`
MIGRATOR_DATABASE_URL=postgres://migrator:change-me-migrator@127.0.0.1:5433/email_assistant?sslmode=disable
PORT=8080
LOG_LEVEL=info
# json = one JSON object per line (the VPS); text = "[module] event key=value" (dev). Unset = json.
LOG_FORMAT=text

# 32 random bytes, base64: openssl rand -base64 32. Store a copy in a password manager: key loss = all mailboxes connect again.
CREDENTIALS_KEY=###
CREDENTIALS_KEY_VERSION=1

# Local GreenMail test server (bun run dev:up)
TEST_IMAP_HOST=127.0.0.1
TEST_IMAP_PORT=3143
TEST_IMAPS_PORT=3993
TEST_SMTP_PORT=3025

# Dead-man's-switch ping URL (empty = heartbeat off)
HEARTBEAT_URL=

# Address of the test mailbox for the test tools only (mailbox:seed and probes refuse all others). No scope reads it.
TEST_MAILBOX_ADDRESS=

# Test tool only (bun run testmail:*): AgentMail key. Secret.
AGENTMAIL_API_KEY=
# AGENTMAIL_BASE_URL=https://api.agentmail.to/v0
