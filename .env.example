# Google Gemini API (create the key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=###
# Model ID from https://ai.google.dev/gemini-api/docs/models (newest Flash, checked 2026-11-02)
GEMINI_MODEL=gemini-3.8-flash

# Dev Compose db: superuser and role passwords (the db init script reads them on an empty volume)
POSTGRES_PASSWORD=change-me-postgres
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

# The passwords in the URLs must match MIGRATOR_PASSWORD and APP_PASSWORD above
# Server connects as the DB role `app` (dev Compose db listens on host port 5433)
DATABASE_URL=postgres://app:change-me-app@127.0.0.1:5433/email_assistant?sslmode=disable
# dbmate runs the migrations as the DB role `migrator`
MIGRATOR_DATABASE_URL=postgres://migrator:change-me-migrator@127.0.0.1:5433/email_assistant?sslmode=disable
PORT=8080
LOG_LEVEL=info

# 32 random bytes, base64: openssl rand -base64 32. Store a copy in a password manager: key loss = all mailboxes connect again.
CREDENTIALS_KEY=###
CREDENTIALS_KEY_VERSION=1

# Local GreenMail test server (bun run dev:up)
TEST_IMAP_HOST=127.0.0.1
TEST_IMAP_PORT=3143
TEST_IMAPS_PORT=3993
TEST_SMTP_PORT=3025

# Dead-man's-switch ping URL (empty = heartbeat off)
HEARTBEAT_URL=

# Address of the test mailbox (mailbox:seed refuses all others)
TEST_MAILBOX_ADDRESS=
