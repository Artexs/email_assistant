{
  "name": "email-assistant",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test:unit": "bun test packages/core apps/server/src",
    "test:int": "bun test apps/server/test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "web:dev": "bun run --filter @ea/web dev",
    "web:build": "bun run --filter @ea/web build",
    "gemini:test": "bun apps/server/src/scripts/gemini-check.ts",
    "db:up": "docker compose -f deploy/compose.yaml --env-file .env up -d --wait db",
    "db:down": "docker compose -f deploy/compose.yaml --env-file .env down",
    "db:migrate": "dbmate -e MIGRATOR_DATABASE_URL --no-dump-schema --wait migrate",
    "db:rollback": "dbmate -e MIGRATOR_DATABASE_URL --no-dump-schema rollback",
    "db:types": "kysely-codegen --dialect postgres --url 'env(MIGRATOR_DATABASE_URL)' --out-file apps/server/src/platform/db/schema.ts --exclude-pattern schema_migrations"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.7",
    "@eslint/js": "9.23.0",
    "@types/bun": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "dbmate": "^2.37.0",
    "eslint": "9.23.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.2.5",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.5",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-compiler": "19.0.0-beta-aeaed83-20250323",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.28.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
