{
  "name": "email-assistant",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun --watch apps/server/src/main.ts",
    "start": "bun apps/server/src/main.ts",
    "test:unit": "bun test packages/core apps/server/src tools/fake-telegram/src apps/web/src/lib apps/web/src/i18n apps/web/integrations",
    "test:int": "bun test apps/server/test tools/fake-telegram/test",
    "test:unit:ci": "bash scripts/ci-bun.sh run test:unit",
    "test:int:ci": "bash scripts/ci-bun.sh run test:int",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "graph:modules": "bun apps/server/src/scripts/module-graph.ts",
    "format": "prettier --write .",
    "fake-tg": "bun tools/fake-telegram/src/cli.ts",
    "web:dev": "bun run --filter @ea/web dev",
    "web:build": "bun run --filter @ea/web build",
    "test:e2e": "bunx playwright test -c apps/web/e2e/playwright.config.ts",
    "rules:add": "bun apps/server/src/scripts/rules.ts add",
    "rules:list": "bun apps/server/src/scripts/rules.ts list",
    "delegates:add": "bun apps/server/src/scripts/delegates.ts add",
    "delegates:list": "bun apps/server/src/scripts/delegates.ts list",
    "delegates:disable": "bun apps/server/src/scripts/delegates.ts disable",
    "delegates:enable": "bun apps/server/src/scripts/delegates.ts enable",
    "delegations:list": "bun apps/server/src/scripts/delegations.ts list",
    "delegations:done": "bun apps/server/src/scripts/delegations.ts done",
    "job:run": "bun apps/server/src/scripts/job-run.ts",
    "triage:cost": "bun apps/server/src/scripts/triage-cost.ts",
    "triage:label": "bun apps/server/src/scripts/triage-label.ts",
    "eval": "bun apps/server/src/scripts/eval.ts",
    "sim": "bun apps/server/src/scripts/sim.ts",
    "testmail:setup": "bun apps/server/src/scripts/testmail.ts setup",
    "testmail:validate": "bun apps/server/src/scripts/testmail.ts validate",
    "testmail:blind": "bun apps/server/src/scripts/testmail.ts blind",
    "testmail:send": "bun apps/server/src/scripts/testmail.ts send",
    "testmail:status": "bun apps/server/src/scripts/testmail.ts status",
    "testmail:target": "bun apps/server/src/scripts/testmail-target.ts",
    "testmail:remote": "bun apps/server/src/scripts/testmail-remote.ts",
    "llm:check": "bun apps/server/src/scripts/llm-check.ts",
    "gemini:test": "bun apps/server/src/scripts/llm-check.ts --provider gemini",
    "org:create": "bun apps/server/src/scripts/org-create.ts",
    "org:flag": "bun apps/server/src/scripts/org-flag.ts",
    "org:break-glass": "bun apps/server/src/scripts/org-break-glass.ts",
    "org:invite": "bun apps/server/src/scripts/org-invite.ts",
    "org:plan": "bun apps/server/src/scripts/org-plan.ts",
    "org:status": "bun apps/server/src/scripts/org-status.ts",
    "web:invite": "bun apps/server/src/scripts/web-invite.ts",
    "e2e:seed": "bun apps/server/src/scripts/e2e-seed.ts",
    "telegram:check": "bun apps/server/src/scripts/telegram-check.ts",
    "telegram:link": "bun apps/server/src/scripts/telegram-link.ts",
    "telegram:unlink": "bun apps/server/src/scripts/telegram-unlink.ts",
    "digest:times": "bun apps/server/src/scripts/digest-times.ts",
    "mailbox:connect": "bun apps/server/src/scripts/mailbox-connect.ts",
    "mailbox:password": "bun apps/server/src/scripts/mailbox-password.ts",
    "mailbox:check": "bun apps/server/src/scripts/mailbox-check.ts",
    "mailbox:probe-move": "bun apps/server/src/scripts/mailbox-probe-move.ts",
    "mailbox:probe-send": "bun apps/server/src/scripts/mailbox-probe-send.ts",
    "mailbox:seed": "bun apps/server/src/scripts/mailbox-seed.ts",
    "mailbox:rescan": "bun apps/server/src/scripts/mailbox-rescan.ts",
    "mailbox:audit": "bun apps/server/src/scripts/mailbox-audit.ts",
    "mailbox:signals": "bun apps/server/src/scripts/mailbox-signals.ts",
    "stats:week": "bun apps/server/src/scripts/stats-week.ts",
    "mailbox:backfill": "bun apps/server/src/scripts/mailbox-backfill.ts",
    "mailbox:settings": "bun apps/server/src/scripts/mailbox-settings.ts",
    "db:up": "docker compose -f deploy/compose.yaml -f deploy/compose.dev.yaml --env-file .env up -d --wait db",
    "dev:up": "docker compose -f deploy/compose.yaml -f deploy/compose.dev.yaml --env-file .env up -d --wait db greenmail",
    "db:down": "docker compose -f deploy/compose.yaml -f deploy/compose.dev.yaml --env-file .env down",
    "db:migrate": "dbmate -e MIGRATOR_DATABASE_URL --no-dump-schema --wait migrate",
    "db:worktree": "bun apps/server/src/scripts/db-worktree.ts",
    "db:rollback": "dbmate -e MIGRATOR_DATABASE_URL --no-dump-schema rollback",
    "db:types": "kysely-codegen --dialect postgres --url 'env(MIGRATOR_DATABASE_URL)' --out-file apps/server/src/platform/db/schema.ts --exclude-pattern schema_migrations"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.7",
    "@eslint/js": "9.23.0",
    "@types/bun": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "dbmate": "^2.37.0",
    "eslint": "9.23.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.2.5",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.5",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-compiler": "19.0.0-beta-aeaed83-20250323",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.28.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
