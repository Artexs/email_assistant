# Settings for deploy/backup.sh. Copy to deploy/backup.env (not in git) and fill in.

# Local folder for the encrypted dumps (absolute path).
BACKUP_DIR=/home/<user>/ea-backups

# age public key (age1...). The private key never lives on the VPS.
AGE_RECIPIENT=age1<public key>

# rclone destination <remote>:<bucket>/<path>. Make the remote with `rclone config`.
BACKUP_REMOTE=b2:<bucket>/pilot

# Days to keep local files (remote files: lifecycle rule on the bucket).
KEEP_DAYS=7

# Container CLI.
COMPOSE="docker compose"
