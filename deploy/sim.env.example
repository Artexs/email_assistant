# Env of the sim stack (deploy/compose.sim.yaml). Copy to deploy/sim.env (git ignores it) and fill the placeholders:
#   cp deploy/sim.env.example deploy/sim.env
# server, lab and fake-telegram read only this file, never ../.env. bun run lab:env-check refuses a wrong value before each of them starts.
# Secrets: never print or log them. Keep the file out of git.

# The sim stack marks itself. A production .env must never carry this value.
LAB_STACK=ea-sim
# The sim mail host is GreenMail in the same network namespace (127.0.0.1, deploy/compose.sim.yaml); the lab mailbox host is 127.0.0.1.
MAIL_ALLOW_LOCAL_HOSTS=true

# The fake Telegram runs in the same network namespace (deploy/compose.sim.yaml). The token is the public default of tools/fake-telegram; never a real bot token.
TELEGRAM_API_ROOT=http://127.0.0.1:8090
TELEGRAM_BOT_TOKEN=1000001:fake-telegram-token-local-tests-only

# Sends go only to the lab addresses (every address of evals/sim/lab-01 and the other_address aliases, 26 of them).
SEND_SCOPE=self
SEND_TEST_ADDRESSES=billing@paliwa-fiota.test,daniel.hargreaves@baltic-freight-partners.test,deals@premium-leads-pro.test,digest@supplychain-weekly.test,dorota.wilczynska@kordelan.test,dorota.wilczynska@poczta-prywatna.test,ewelina.marszalek@paliwa-flota.test,g.jastrzebska@hurtownia-zielona.test,halina.strzemecka@kordelan.test,karin.lindqvist@nordicfoods-trade.test,magdalena.czerniak@kordelan.test,magdalena.czerniak@poczta-prywatna.test,mailer-daemon@kordelan.test,matthias.brandt@trailerwerk-sued.test,noreply@bank-aurum.test,noreply@erp-kordelan.test,oferty@targi-magazynowe.test,oliver.pemberton@kordelan.test,piotr.lewandrowski@kordelan.test,piotr.lewandrowski@poczta-prywatna.test,rafal.kwiecinski@kordelan.test,redakcja@logistyka-dzis.test,tomasz.brzezinski@meblodrew.test,wiktor.szalewski@demo.kordelan.test,wiktor.szalewski@kordelan.test,z.orlowicz@rada-kordelan.test
TRIAGE_LLM_SCOPE=all
ACTIONS_SCOPE=all
# Production send limits (PD-068 checks real limits)
SEND_LIMIT_MAILBOX_HOUR=20
SEND_LIMIT_MAILBOX_DAY=100
SEND_LIMIT_RECIPIENT_DAY=5
# LLM calls per mailbox per America/Los_Angeles day: a lab day of 156 mails plus drafts stays under 600 (review N10).
LLM_DAILY_CAP=600

# Must stay empty in the sim stack (the guard refuses a value)
HEARTBEAT_URL=
OPERATOR_TELEGRAM_CHAT_ID=
OPERATOR_USER_IDS=
# No AUTH_SMTP_* key: the guard refuses any value, and the invite goes through web:invite --print.

# LLM keys: one provider for every role. LLM_PROVIDER is openai (empty = openai), gemini or deepseek; the server refuses to start
# without the key of that provider (OPENAI_API_KEY, GEMINI_API_KEY or DEEPSEEK_API_KEY) while TRIAGE_LLM_SCOPE is not off.
# DeepSeek has a sub-processor row, so production may use it too; here the mail is generated (LAB_STACK=ea-sim).
# Fill the key of your provider on the VPS only (`deploy/README.md` § Sim stack, step 5). Empty keys do not turn the LLM off: they stop the server.
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Web panel: the Tailscale Serve address of the VPS, port 8443. Replace <host>.
WEB_BASE_URL=https://<host>:8443
# The gateway of the sim network (172.31.0.0/24)
WEB_TRUSTED_PROXIES=172.31.0.1
WEB_TRUSTED_ORIGINS=
# Session cookie secret: openssl rand -base64 32
WEB_AUTH_SECRET=replace-with-openssl-rand-base64-32
# 32 random bytes, base64: openssl rand -base64 32. Keep a copy: a lost key means every mailbox connects again.
CREDENTIALS_KEY=replace-with-openssl-rand-base64-32
CREDENTIALS_KEY_VERSION=1

# Passwords of the sim database: make each with openssl rand -hex 24. The compose file builds the DB URLs from them.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-24
APP_PASSWORD=replace-with-openssl-rand-hex-24
# The sim-only base image tag of the release: docker build -f deploy/Dockerfile --build-arg EA_RELEASE=<tag> -t ea-sim-base:<tag> . (never the production tag ea-server). The runbook sets it.
EA_SERVER_IMAGE=ea-sim-base
