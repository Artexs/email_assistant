---
// The claims of the security page: the claim, the proof files on GitHub, the condition. Each row has the anchor `claim-<id>`
// (the checklist at the top of the page links to it). The data is `publicClaims`; the build checks it (`claimCheck`).
import type { UserLocale } from "@ea/core";
import { proofUrl, publicClaims } from "../security/claims";

interface Props {
  lang: UserLocale;
}

const { lang } = Astro.props;
const labels = {
  en: { claim: "Claim", proof: "Proof", condition: "Condition", none: "—" },
  pl: { claim: "Twierdzenie", proof: "Dowód", condition: "Warunek", none: "—" },
}[lang];
const fileName = (path: string): string => path.slice(path.lastIndexOf("/") + 1);
---

<table>
  <thead>
    <tr>
      <th scope="col">{labels.claim}</th>
      <th scope="col">{labels.proof}</th>
      <th scope="col">{labels.condition}</th>
    </tr>
  </thead>
  <tbody>
    {
      publicClaims.map((claim) => (
        <tr id={`claim-${claim.id}`}>
          <td>{claim.text[lang]}</td>
          <td>
            <ul>
              {claim.proofs.map((path) => (
                <li>
                  <a href={proofUrl(path)}>{fileName(path)}</a>
                </li>
              ))}
            </ul>
          </td>
          <td>{claim.condition?.[lang] ?? labels.none}</td>
        </tr>
      ))
    }
  </tbody>
</table>
