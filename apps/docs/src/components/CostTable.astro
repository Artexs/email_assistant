---
// The cost to run one mailbox for one month, at three mail volumes. Every amount comes from `costRows` (the code), never from page text.
import type { UserLocale } from "@ea/core";
import { basisNote, costBasis, costRows, formatUsd, hostSizeNote, roundingNote } from "../pricing";

interface Props {
  lang?: UserLocale;
}

const { lang = "en" } = Astro.props;
const labels = {
  en: {
    caption: "Cost to run one mailbox for one month, in US dollars",
    mails: "Mails a day",
    llm: "AI",
    hosting: "Hosting",
    backup: "Backup",
    total: "Total",
    margin: "Margin at the placeholder price",
  },
  pl: {
    caption: "Koszt utrzymania jednej skrzynki przez miesiąc, w dolarach amerykańskich",
    mails: "Wiadomości dziennie",
    llm: "AI",
    hosting: "Hosting",
    backup: "Kopie zapasowe",
    total: "Razem",
    margin: "Marża przy cenie tymczasowej",
  },
}[lang];
const rows = costRows();
---

<!-- Starlight makes a table scroll on a narrow screen. The table holds no link, so it takes focus itself: a keyboard user can scroll it (axe `scrollable-region-focusable`). -->
<table tabindex="0">
  <caption>{labels.caption}</caption>
  <thead>
    <tr>
      <th scope="col">{labels.mails}</th>
      <th scope="col">{labels.llm}</th>
      <th scope="col">{labels.hosting}</th>
      <th scope="col">{labels.backup}</th>
      <th scope="col">{labels.total}</th>
      <th scope="col">{labels.margin}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.mailsPerDay}</th>
          <td>{formatUsd(row.llmUsd, lang)}</td>
          <td>{formatUsd(row.hostingUsd, lang)}</td>
          <td>{formatUsd(row.backupUsd, lang)}</td>
          <td>{formatUsd(row.totalUsd, lang)}</td>
          <td>{formatUsd(row.marginUsd, lang)}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p>{hostSizeNote(lang)}</p>
<p>{roundingNote(lang)}</p>
<p>{basisNote(costBasis(), undefined, lang)}</p>
