---
// The cost to run one mailbox for one month, at three mail volumes. Every amount comes from `costRows` (the code), never from page text.
import { basisNote, costBasis, costRows, formatUsd, hostSizeNote, ROUNDING_NOTE } from "../pricing";

const rows = costRows();
---

<table>
  <caption>Cost to run one mailbox for one month, in US dollars</caption>
  <thead>
    <tr>
      <th scope="col">Mails a day</th>
      <th scope="col">AI</th>
      <th scope="col">Hosting</th>
      <th scope="col">Backup</th>
      <th scope="col">Total</th>
      <th scope="col">Margin at the placeholder price</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.mailsPerDay}</th>
          <td>{formatUsd(row.llmUsd)}</td>
          <td>{formatUsd(row.hostingUsd)}</td>
          <td>{formatUsd(row.backupUsd)}</td>
          <td>{formatUsd(row.totalUsd)}</td>
          <td>{formatUsd(row.marginUsd)}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p>{hostSizeNote()}</p>
<p>{ROUNDING_NOTE}</p>
<p>{basisNote(costBasis())}</p>
