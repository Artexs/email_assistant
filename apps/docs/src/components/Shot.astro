---
// A screenshot of a panel page in the page language, desktop and phone. Put it on its own line:
// `<Shot page="settings" />` (`bodyHash` ignores such lines). `DOCS_SHOTS=on`: a missing file fails the build (`shot_missing <name>`);
// unset: a box with the alt text. An unknown page fails the build in both cases.
import {
  SHOT_DESKTOP_SIZE,
  SHOT_PHONE_MEDIA,
  shotFileExists,
  shotSourceKind,
  shotsOn,
  shotUrl,
  shotView,
} from "../shots";

interface Props {
  page: string;
}

const { page } = Astro.props;
const on = shotsOn();
const view = shotView(page, Astro.currentLocale, {
  on,
  exists: (name) => shotFileExists(name),
  source: shotSourceKind(),
});
---

{
  view.kind === "images" ? (
    <figure class="shot">
      <picture>
        <source media={SHOT_PHONE_MEDIA} srcset={shotUrl(view.phone.name)} />
        <img
          src={shotUrl(view.desktop.name)}
          alt={view.desktop.alt}
          width={SHOT_DESKTOP_SIZE.width}
          height={SHOT_DESKTOP_SIZE.height}
          loading="lazy"
        />
      </picture>
    </figure>
  ) : (
    <div class="shot-off">{view.desktop.alt}</div>
  )
}
