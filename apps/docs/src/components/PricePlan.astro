---
// The one plan. The price is the constant of `@ea/core`.
import { PLACEHOLDER_PRICE } from "../pricing";
---

<section class="plan">
  <p><strong>{PLACEHOLDER_PRICE}</strong> per mailbox per month</p>
  <ul>
    <li>Sorts the mail of one mailbox into categories.</li>
    <li>Sends a daily digest to Telegram.</li>
    <li>Prepares drafts and delegations. It sends nothing until you approve.</li>
    <li>Moves are undoable.</li>
  </ul>
</section>
