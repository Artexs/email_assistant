---
import { SearchX } from "lucide-react";

import NoticeCard from "../components/shell/NoticeCard.astro";
import Public from "../layouts/Public.astro";
import { en } from "../i18n/en";
import { pl } from "../i18n/pl";
---

<Public titleKey="title_not_found">
  <NoticeCard
    icon={SearchX}
    pl={{ title: pl.not_found_title, text: pl.not_found_text, link: pl.not_found_link }}
    en={{ title: en.not_found_title, text: en.not_found_text, link: en.not_found_link }}
  />
</Public>
