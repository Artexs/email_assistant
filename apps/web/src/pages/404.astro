---
import Public from "../layouts/Public.astro";
import { en } from "../i18n/en";
import { pl } from "../i18n/pl";
---

<Public titleKey="title_not_found">
  <h1 lang="pl" class="text-xl font-semibold">{pl.not_found_title}</h1>
  <p lang="pl">{pl.not_found_text}</p>
  <a href="/" lang="pl" class="underline">{pl.not_found_link}</a>
  <p class="font-semibold">{en.not_found_title}</p>
  <p>{en.not_found_text}</p>
  <a href="/" class="underline">{en.not_found_link}</a>
</Public>
