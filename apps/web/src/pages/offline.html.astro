---
import { WifiOff } from "lucide-react";

import NoticeCard from "../components/shell/NoticeCard.astro";
import Public from "../layouts/Public.astro";
import { en } from "../i18n/en";
import { pl } from "../i18n/pl";
---

<Public titleKey="offline_title">
  <NoticeCard
    icon={WifiOff}
    pl={{ title: pl.offline_title, text: pl.offline_text, link: pl.offline_retry }}
    en={{ title: en.offline_title, text: en.offline_text, link: en.offline_retry }}
  />
</Public>
