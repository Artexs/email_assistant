---
import Public from "../layouts/Public.astro";
import { en } from "../i18n/en";
import { pl } from "../i18n/pl";
---

<Public titleKey="offline_title">
  <h1 lang="pl" class="text-xl font-semibold">{pl.offline_title}</h1>
  <p lang="pl">{pl.offline_text}</p>
  <a href="/" lang="pl" class="underline">{pl.offline_retry}</a>
  <p class="font-semibold">{en.offline_title}</p>
  <p>{en.offline_text}</p>
  <a href="/" class="underline">{en.offline_retry}</a>
</Public>
