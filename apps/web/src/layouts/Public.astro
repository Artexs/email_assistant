---
import type { UserLocale } from "@ea/core/web";

import "../styles/global.css";
import { BrandMark } from "../components/shell/BrandMark";
import { en, type TextKey } from "../i18n/en";

interface Props {
  titleKey?: TextKey;
  // A page whose title is not a key (the legal pages) passes the text; it wins over `titleKey`.
  title?: string;
  // The language of the page text, printed in `<html lang>`.
  lang?: UserLocale;
  // `card`: a centred column with the brand line. `split`: the page is full width and its island draws the columns (login, setup).
  // `reading`: a column of at most 768 px that starts at the top, with the text in one card (the legal texts).
  frame?: "card" | "split" | "reading";
}

const { titleKey, title, lang = "en", frame = "card" } = Astro.props;
const pageTitle = title ?? (titleKey === undefined ? en.brand : en[titleKey]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0a7568" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1513" />
    <title>{pageTitle} · {en.brand}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <noscript>{en.noscript}</noscript>
    {
      frame === "split" ? (
        <main class="min-h-screen w-full">
          <slot />
        </main>
      ) : frame === "reading" ? (
        <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col gap-4 p-4 lg:gap-6 lg:p-6">
          <a href="/login" class="flex items-center gap-3 self-start text-lg font-extrabold">
            <BrandMark />
            {en.brand}
          </a>
          <div class="flex min-w-0 flex-col gap-6 rounded-lg bg-card p-4 text-card-foreground shadow-card break-words lg:p-6">
            <slot />
          </div>
        </main>
      ) : (
        <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center gap-6 p-6">
          <p class="flex items-center justify-center gap-3 text-lg font-extrabold">
            <BrandMark />
            {en.brand}
          </p>
          <slot />
        </main>
      )
    }
  </body>
</html>
