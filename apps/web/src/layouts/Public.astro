---
import type { UserLocale } from "@ea/core/web";

import "../styles/global.css";
import { en, type TextKey } from "../i18n/en";

interface Props {
  titleKey?: TextKey;
  // A page whose title is not a key (the legal pages) passes the text; it wins over `titleKey`.
  title?: string;
  // The language of the page text, printed in `<html lang>`.
  lang?: UserLocale;
  // A reading page (the legal texts): wide, starts at the top, not a centred card.
  reading?: boolean;
}

const { titleKey, title, lang = "en", reading = false } = Astro.props;
const pageTitle = title ?? (titleKey === undefined ? en.brand : en[titleKey]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#000832" />
    <title>{pageTitle} · {en.brand}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <noscript>{en.noscript}</noscript>
    <main
      class:list={[
        "mx-auto flex min-h-screen w-full flex-col gap-6 p-6",
        reading ? "max-w-3xl justify-start" : "max-w-md justify-center",
      ]}
    >
      <p class="text-center text-lg font-semibold">{en.brand}</p>
      <slot />
    </main>
  </body>
</html>
