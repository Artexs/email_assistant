# build output
dist/

# generated types
.astro/

# dbmate schema dump (not used: --no-dump-schema)
db/schema.sql

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# backup settings (VPS only)
deploy/backup.env

# restore drill settings (secrets; made by `deploy/restore.sh --target drill --init-env`)
deploy/drill.env

# status of the last backup run (written by deploy/backup.sh, read by the server check)
deploy/backup-status/status.json
deploy/backup-status/status.json.tmp
deploy/backup-status/backup.lock

# sim stack settings (secrets; made from deploy/sim.env.example)
deploy/sim.env

# eval run state (per-case results)
evals/.runs/

# e2e seed output and Playwright reports
apps/web/e2e/.seed.json
apps/web/e2e/.demo-owner.json
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/
# the output of `bun run demo:record` (the default --out folder)
tmp/demo/
apps/docs/e2e/test-results/
apps/docs/e2e/playwright-report/
/.limen/

# docs app build output and generated types
apps/docs/dist/
apps/docs/.astro/
# the screenshots of `bun run docs:shots` (stage 11): made by CI from the e2e seed, never committed
apps/docs/public/shots/
# the demo video of the home page: files of the GitHub release `demo-video`, downloaded by the deploy (`apps/docs/scripts/demo-fetch.ts`), never committed
apps/docs/public/demo/
# the folders of the test builds in `apps/docs/scripts/*.test.ts` (dot folders: the glob scans skip them)
apps/docs/.dist-*-test/

# release state of deploy/release.sh and deploy/rollback.sh (the folder is in git, the file is not)
deploy/release-state/state
deploy/release-state/state.tmp

# VPS database keys (deploy/env-split.sh)
deploy/db.env
