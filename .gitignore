# build output
dist/

# generated types
.astro/

# dbmate schema dump (not used: --no-dump-schema)
db/schema.sql

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# backup settings (VPS only)
deploy/backup.env

# status of the last backup run (written by deploy/backup.sh, read by the server check)
deploy/backup-status/status.json
deploy/backup-status/status.json.tmp

# sim stack settings (secrets; made from deploy/sim.env.example)
deploy/sim.env

# eval run state (per-case results)
evals/.runs/

# e2e seed output and Playwright reports
apps/web/e2e/.seed.json
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/
/.limen/

# docs app build output and generated types
apps/docs/dist/
apps/docs/.astro/

# release state of deploy/release.sh and deploy/rollback.sh (the folder is in git, the file is not)
deploy/release-state/state
deploy/release-state/state.tmp
